NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
LYNK_MERCHANT_KEY=your-lynk-webhook-merchant-key
LYNK_PRODUCT_UUID=your-lynk-product-uuid
# Existing deployments may use MERCHANT_KEY instead of LYNK_MERCHANT_KEY.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=JOOLO
